#!/bin/bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y docker.io unzip curl jq

systemctl enable --now docker

curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
unzip -q /tmp/awscliv2.zip -d /tmp
/tmp/aws/install --update

aws ecr get-login-password --region "${aws_region}" \
  | docker login --username AWS --password-stdin "${ecr_registry}"

docker pull "${ecr_repository_url}:latest"
docker rm -f url-shortener-backend || true

DB_SECRET_ARN=""
for attempt in $(seq 1 30); do
  DB_SECRET_ARN=$(aws rds describe-db-instances \
    --region "${aws_region}" \
    --db-instance-identifier "${db_instance_id}" \
    --query 'DBInstances[0].MasterUserSecret.SecretArn' \
    --output text)

  if [ -n "$DB_SECRET_ARN" ] && [ "$DB_SECRET_ARN" != "None" ]; then
    break
  fi

  sleep 10
done

if [ -z "$DB_SECRET_ARN" ] || [ "$DB_SECRET_ARN" = "None" ]; then
  echo "RDS managed secret was not available" >&2
  exit 1
fi

DB_SECRET=$(aws secretsmanager get-secret-value \
  --region "${aws_region}" \
  --secret-id "$DB_SECRET_ARN" \
  --query SecretString \
  --output text)

DB_USER=$(printf '%s' "$DB_SECRET" | jq -r '.username')
DB_PASSWORD=$(printf '%s' "$DB_SECRET" | jq -r '.password')

docker run -d \
  --name url-shortener-backend \
  --restart unless-stopped \
  -p 5000:5000 \
  -e DB_HOST="${db_host}" \
  -e DB_NAME="${db_name}" \
  -e DB_USER="$DB_USER" \
  -e DB_PASSWORD="$DB_PASSWORD" \
  -e BASE_URL="${base_url}" \
  -e COGNITO_ISSUER_URI="${cognito_issuer_uri}" \
  "${ecr_repository_url}:latest"
